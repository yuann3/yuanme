=== templates/components/code-copy.html
{# A Page that shows code blocks calls this once. Its Sidecar script,
   code-copy.ts, gives each block a button that copies its code, and tells
   screen readers through this element when it has. #}
{# props: label?: string, copied?: string #}
{% macro code_copy(label="Copy", copied="Copied") %}
<p class="visually-hidden" role="status" data-code-copy="{{ label }}" data-copied="{{ copied }}"></p>
{% endmacro %}
=== templates/components/code-copy.ts
import type { MountContext } from "yuanme:mount";

/** A copy button on each code block of a Page that calls `code_copy`. */
export function mount(ctx: MountContext) {
  const status = document.querySelector<HTMLElement>("[data-code-copy]");
  if (!status) return;
  const label = status.dataset.codeCopy ?? "Copy";
  const copied = status.dataset.copied ?? "Copied";
  for (const pre of document.querySelectorAll<HTMLElement>("pre.y-code")) {
    const block = document.createElement("div");
    block.className = "code-block";
    pre.replaceWith(block);
    const button = document.createElement("button");
    button.type = "button";
    button.className = "code-copy";
    button.textContent = label;
    block.append(pre, button);
    let reset: ReturnType<typeof setTimeout> | undefined;
    button.addEventListener(
      "click",
      async () => {
        await navigator.clipboard.writeText(pre.querySelector("code")?.textContent ?? "");
        button.textContent = copied;
        status.textContent = copied;
        clearTimeout(reset);
        reset = setTimeout(() => {
          button.textContent = label;
          status.textContent = "";
        }, 2000);
      },
      { signal: ctx.signal },
    );
  }
}
=== templates/components/pagination.html
{# props: paginator: paginator #}
{% macro pagination(paginator) %}
{% if paginator.prev or paginator.next %}
<nav class="pagination" aria-label="Pages">
  {% if paginator.prev %}<a href="{{ paginator.prev }}" rel="prev">Newer</a>{% endif %}
  <span>Page {{ paginator.number }} of {{ paginator.total }}</span>
  {% if paginator.next %}<a href="{{ paginator.next }}" rel="next">Older</a>{% endif %}
</nav>
{% endif %}
{% endmacro %}
=== templates/components/post-row.html
{# props: post: entry<posts> #}
{% macro post_row(post) %}
<li class="post-row">
  <a href="{{ post.url }}">{{ post.title }}</a>
  <time datetime="{{ post.date }}">{{ post.date | dateformat(format="%-d %B %Y") }}</time>
  <p>{{ post.description }}</p>
</li>
{% endmacro %}
=== templates/components/tag-list.html
{# props: tags: list<string> #}
{% macro tag_list(tags) %}
{% if tags %}
<ul class="tag-list" aria-label="Tags">
  {% for term in taxonomies.tags.terms if term.name in tags %}
  <li><a href="{{ term.url }}" rel="tag">{{ term.name }}</a></li>
  {% endfor %}
</ul>
{% endif %}
{% endmacro %}
