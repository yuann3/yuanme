---
source: crates/yuanme/tests/cli.rs
expression: show_files(&changed)
---
=== .github/dependabot.yml
# Keeps the actions in .github/workflows/deploy.yml up to date. Bumping
# YUANME_VERSION there is yours to do.
# Written by `yuanme init`; it is yours to change.
version: 2
updates:
  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly
=== .github/workflows/deploy.yml
# Builds the Site and deploys it to the Cloudflare Pages project cloudflare-pages:
# a push to main deploys it, and a pull request deploys a preview. Without
# the CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID secrets it only builds.
# Written by `yuanme init`; it is yours to change.
name: Deploy

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

concurrency:
  group: deploy-${{ github.ref }}
  cancel-in-progress: true

jobs:
  deploy:
    runs-on: ubuntu-latest
    env:
      YUANME_VERSION: "[release]"
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      # The yuanme release that ran `yuanme init`, checked against its GitHub
      # attestation.
      - name: Install yuanme
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          archive=yuanme-x86_64-unknown-linux-musl.tar.xz
          gh release download "v$YUANME_VERSION" --repo yuann3/yuanme --pattern "$archive" --dir "$RUNNER_TEMP"
          gh attestation verify "$RUNNER_TEMP/$archive" --repo yuann3/yuanme
          tar -xJf "$RUNNER_TEMP/$archive" -C "$RUNNER_TEMP"
          echo "$RUNNER_TEMP/yuanme-x86_64-unknown-linux-musl" >> "$GITHUB_PATH"
      - uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: .yuanme/cache
          key: yuanme-cache-${{ env.YUANME_VERSION }}-${{ hashFiles('bun.lock') }}-${{ github.sha }}
          restore-keys: yuanme-cache-${{ env.YUANME_VERSION }}-${{ hashFiles('bun.lock') }}-
      # The Managed tools, such as the Tailwind CLI and tsc, which yuanme
      # downloads the first time a build needs one. Their versions come from
      # yuanme's release and yuanme.toml.
      - uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: ~/.cache/yuanme/tools
          key: yuanme-tools-${{ env.YUANME_VERSION }}-${{ hashFiles('yuanme.toml') }}
          restore-keys: yuanme-tools-${{ env.YUANME_VERSION }}-
      - if: hashFiles('package.json') != ''
        uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2.2.0
      - if: hashFiles('package.json') != ''
        run: bun install --frozen-lockfile
      - run: yuanme build --json
      - name: Look for the deploy secrets
        id: secrets
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
        run: |
          if [ -n "$CLOUDFLARE_API_TOKEN" ] && [ -n "$CLOUDFLARE_ACCOUNT_ID" ]; then
            echo "found=true" >> "$GITHUB_OUTPUT"
          else
            echo "::notice::No CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID secrets, so the Site is built but not deployed."
          fi
      # The project's production branch is main: a deploy from another
      # branch is a preview.
      - name: Deploy
        id: deploy
        if: steps.secrets.outputs.found == 'true'
        uses: cloudflare/wrangler-action@953926a2e2182532811c01a25e53647d93bf07c0 # v4.1.3
        with:
          apiToken: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          accountId: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
          command: pages deploy dist --project-name=cloudflare-pages --branch=${{ github.event_name == 'push' && 'main' || format('pr-{0}', github.event.pull_request.number) }}
      - if: github.event_name == 'pull_request' && steps.deploy.outputs.deployment-url != ''
        env:
          URL: ${{ steps.deploy.outputs.deployment-url }}
        run: echo "Preview at $URL" >> "$GITHUB_STEP_SUMMARY"
=== yuanme.toml
#:schema ./.yuanme/schemas/yuanme.toml.json
yuanme = "[X.Y]"

[site]
# Where the Site is served from: canonical links, feeds and the sitemap use it.
url = "https://example.com"
title = "My Site"

[routes.home]
path = "/"
template = "home.html"

[routes.missing]
path = "/404.html"
template = "404.html"

[host]
adapter = "cloudflare-pages"
