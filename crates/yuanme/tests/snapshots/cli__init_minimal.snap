=== styles/site.css
:root {
  color-scheme: light dark;
  font-family: system-ui, sans-serif;
  line-height: 1.5;
}

body {
  max-width: 40rem;
  margin: 0 auto;
  padding: 2rem 1rem;
  /* The browser's own colours for each scheme, set rather than left to
     the canvas, so that links are read against the right background. */
  background: Canvas;
  color: CanvasText;
}
=== templates/404.html
{% extends "layouts/base.html" %}
{% set title = "Not found" %}
{% block content %}
<h1>Not found</h1>
<p>Nothing is here. <a href="/">Go to the home Page</a>.</p>
{% endblock %}
