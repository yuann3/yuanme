  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Site config for yuanme.",
  "properties": {
    "build": {
      "additionalProperties": false,
      "description": "How yuanme builds the Site's stylesheets and Scripts.",
      "properties": {
        "targets": {
          "additionalProperties": false,
          "description": "The oldest browsers the Site supports, as explicit versions such as { chrome = \"111\", safari = \"16.4\" }. yuanme adds the prefixes and fallbacks they need and drops the rest; a browser left out gets none. Defaults to Tailwind v4's baseline: Chrome 111, Firefox 128 and Safari 16.4.",
          "properties": {
            "chrome": {
              "description": "Chrome.",
              "pattern": "^[0-9]+(\\.[0-9]+){0,2}$",
              "type": "string"
            },
            "edge": {
              "description": "Edge.",
              "pattern": "^[0-9]+(\\.[0-9]+){0,2}$",
              "type": "string"
            },
            "firefox": {
              "description": "Firefox.",
              "pattern": "^[0-9]+(\\.[0-9]+){0,2}$",
              "type": "string"
            },
            "opera": {
              "description": "Opera.",
              "pattern": "^[0-9]+(\\.[0-9]+){0,2}$",
              "type": "string"
            },
            "safari": {
              "description": "Safari, on macOS and on iOS.",
              "pattern": "^[0-9]+(\\.[0-9]+){0,2}$",
              "type": "string"
            },
            "samsung": {
              "description": "Samsung Internet.",
              "pattern": "^[0-9]+(\\.[0-9]+){0,2}$",
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "collections": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "dir": {
            "description": "The folder of the Collection's Entries. Defaults to \"content/<name>\".",
            "type": "string"
          },
          "fields": {
            "additionalProperties": {
              "$ref": "#/$defs/field"
            },
            "description": "Fields Entries have beyond the built-in `title`, `date`, `updated`, `slug`, `draft` and `unlisted`. Declaring `date` makes it required.",
            "type": "object"
          },
          "list_route": {
            "description": "The URL of the page listing the Collection, such as \"/blog/\". Page N ≥ 2 is at \"<list_route>N/\".",
            "pattern": "^/[^{}]*$",
            "type": "string"
          },
          "paginate": {
            "description": "Entries per list page. Needs `list_route`.",
            "minimum": 1,
            "type": "integer"
          },
          "route": {
            "description": "The URL of each Entry, with `{slug}` where its Slug goes, such as \"/blog/{slug}/\".",
            "pattern": "^/[^{}]*\\{slug\\}[^{}]*$",
            "type": "string"
          },
          "sort": {
            "description": "Field names to sort Entries by, each prefixed with `-` for descending. Entries missing a key sort last; ties break by Slug. Defaults to [\"-date\"].",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "template": {
            "description": "The Template of each Entry's Page. Defaults to \"<name>/entry.html\".",
            "type": "string"
          }
        },
        "required": [
          "route"
        ],
        "type": "object"
      },
      "description": "Named groups of Entries sharing one schema, such as posts or projects.",
      "type": "object"
    },
    "data": {
      "additionalProperties": {
        "$ref": "#/$defs/item"
      },
      "description": "Schemas for Data files: `[data.nav]` checks `data/nav.toml`, `.yaml` or `.json`. A Data file without one is not checked.",
      "type": "object"
    },
    "feeds": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "collections": {
            "description": "The Collections whose Entries the feed holds.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "path": {
            "description": "The URL of the feed, such as \"/rss.xml\".",
            "pattern": "^/[^{}]*$",
            "type": "string"
          },
          "template": {
            "description": "The Template that writes the feed. Defaults to \"rss.xml\": the built-in RSS 2.0 Template, unless `templates/rss.xml` replaces it.",
            "type": "string"
          }
        },
        "required": [
          "collections",
          "path"
        ],
        "type": "object"
      },
      "description": "Feeds of published, listed Entries, newest first.",
      "type": "object"
    },
    "host": {
      "additionalProperties": false,
      "description": "The static host the Site is deployed to, and the headers and redirects it sends.",
      "properties": {
        "adapter": {
          "description": "The host whose configuration the build writes: \"cloudflare\" (Workers static assets, the default), \"netlify\", \"vercel\", \"github-pages\", \"cloudflare-pages\" or \"static\".",
          "enum": [
            "cloudflare",
            "netlify",
            "vercel",
            "github-pages",
            "cloudflare-pages",
            "static"
          ]
        },
        "headers": {
          "description": "Response headers for the URLs a path matches, after yuanme's own cache rules. Where two rules set one header, the later one wins.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "headers": {
                "additionalProperties": {
                  "type": "string"
                },
                "description": "The headers, by name: { \"Cache-Control\" = \"public, max-age=3600\" }.",
                "type": "object"
              },
              "path": {
                "description": "The URL path the headers are for, such as \"/resume.pdf\". One `*` matches any characters: \"/fonts/*\".",
                "pattern": "^/[^{}]*$",
                "type": "string"
              }
            },
            "required": [
              "path",
              "headers"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "precompress": {
          "description": "Write a brotli `.br` and a gzip `.gz` beside each text file, for Caddy or nginx. Only with the `static` adapter: no other host serves them.",
          "type": "boolean"
        },
        "redirects": {
          "description": "URLs the host redirects, such as a Page's old address.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "from": {
                "description": "The URL path that redirects, such as \"/old-post/\".",
                "pattern": "^/[^{}]*$",
                "type": "string"
              },
              "status": {
                "description": "301, 302, 307 or 308. Defaults to 308, a permanent redirect that keeps the method.",
                "minimum": 301,
                "type": "integer"
              },
              "to": {
                "description": "Where it goes: a URL path such as \"/blog/new-post/\", or an absolute URL.",
                "type": "string"
              }
            },
            "required": [
              "from",
              "to"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "images": {
      "additionalProperties": false,
      "description": "How yuanme resizes and encodes the images that bodies, `image` fields and `image()` name.",
      "properties": {
        "avif_speed": {
          "description": "How hard the AVIF encoder works, from 1, the smallest files and slowest, to 10. Defaults to 6.",
          "maximum": 10,
          "minimum": 1,
          "type": "integer"
        },
        "formats": {
          "description": "The formats offered before the JPEG fallback, or PNG for a source with transparency, in order. Defaults to [\"avif\"], which every default target browser decodes; add \"webp\" for older ones.",
          "items": {
            "enum": [
              "avif",
              "webp"
            ]
          },
          "type": "array"
        },
        "quality": {
          "additionalProperties": false,
          "description": "Each encoder's quality, on its own scale from 1 to 100.",
          "properties": {
            "avif": {
              "description": "Defaults to 72.",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            "jpeg": {
              "description": "Defaults to 80.",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            "webp": {
              "description": "Defaults to 80.",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "sizes": {
          "description": "The `sizes` attribute: how wide an image is shown, which picks the width a browser fetches. Defaults to \"100vw\"; set it to the prose width, such as \"(min-width: 768px) 720px, 100vw\".",
          "type": "string"
        },
        "widths": {
          "description": "The widths each image is resized to, in pixels. A source narrower than one uses its own width instead: nothing is upscaled. Defaults to [480, 800, 1200, 1600, 2400].",
          "items": {
            "maximum": 16383,
            "minimum": 1,
            "type": "integer"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "math": {
      "additionalProperties": false,
      "description": "How math renders.",
      "properties": {
        "macros": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "LaTeX macros for every Entry's math, by name without the backslash: `R = '\\mathbb{R}'`, or with arguments, `norm = '\\left\\lVert #1 \\right\\rVert'`.",
          "type": "object"
        }
      },
      "type": "object"
    },
    "routes": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "description": "The URL of the Page, such as \"/\" or \"/404.html\".",
            "pattern": "^/[^{}]*$",
            "type": "string"
          },
          "template": {
            "description": "The Template that makes the Page, by its path in `templates/`, such as \"home.html\".",
            "type": "string"
          }
        },
        "required": [
          "path",
          "template"
        ],
        "type": "object"
      },
      "description": "Pages made by a Template alone, such as the home page or the 404 page.",
      "type": "object"
    },
    "site": {
      "additionalProperties": false,
      "description": "The Site's metadata.",
      "properties": {
        "author": {
          "description": "The Author's name.",
          "type": "string"
        },
        "description": {
          "description": "One or two sentences about the Site, for feeds and search engines.",
          "type": "string"
        },
        "extra": {
          "description": "Anything else Templates need, under keys of your own.",
          "type": "object"
        },
        "language": {
          "description": "The language of the Site's content, as a BCP 47 tag such as \"en\" or \"zh-Hans\".",
          "type": "string"
        },
        "timezone": {
          "description": "The IANA time zone, such as \"Asia/Singapore\", for datetimes written without an offset. Defaults to \"UTC\", never the machine's zone.",
          "type": "string"
        },
        "title": {
          "description": "The Site's name.",
          "type": "string"
        },
        "url": {
          "description": "The address the Site is served from, such as \"https://example.com\". Feeds, sitemaps and canonical links are built from it.",
          "format": "uri",
          "pattern": "^https?://[^/\\s]+",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "taxonomies": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "collections": {
            "description": "The Collections whose Entries it groups. Each gets a field with the Taxonomy's name.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "lowercase": {
            "description": "Show every Term in lowercase. Otherwise a Term shows as first spelled.",
            "type": "boolean"
          },
          "paginate": {
            "description": "Entries per Term page.",
            "minimum": 1,
            "type": "integer"
          },
          "route": {
            "description": "The URL of each Term's page, with `{term}` where its Slug goes, such as \"/tags/{term}/\".",
            "pattern": "^/[^{}]*\\{term\\}[^{}]*$",
            "type": "string"
          },
          "single": {
            "description": "Each Entry has at most one Term, written as a string rather than a list.",
            "type": "boolean"
          },
          "slugs": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Slugs that override the ones yuanme derives, by Term: { \"C++\" = \"cpp\" }.",
            "type": "object"
          },
          "sort": {
            "description": "How Entries sort on a Term's page, as for a Collection.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "template": {
            "description": "The Template of each Term's Page. Defaults to \"<name>/term.html\".",
            "type": "string"
          }
        },
        "required": [
          "collections",
          "route"
        ],
        "type": "object"
      },
      "description": "Named ways of grouping Entries by a shared value, such as tags or series.",
      "type": "object"
    },
    "yuanme": {
      "description": "The oldest yuanme release this project works with, as \"X.Y\". A newer minor release in the same major builds it; before 1.0, only the same 0.Y does.",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "type": "string"
    }
  },
  "required": [
    "site"
  ],
  "title": "yuanme.toml",
  "type": "object"
}
