<li class="task-list-item"><input type="checkbox" checked disabled> Task 2</li>
<li class="task-list-item"><input type="checkbox" checked disabled> Task 3</li>
<li class="task-list-item"><input type="checkbox" disabled> Task 4</li>
<li class="task-list-item"><input type="checkbox" checked disabled> Task 5</li>
</ul>
<h4 id="checklist-2-25">Checklist 2 [2/5]</h4>
<p>Checklist showing progress in ratio.</p>
<ul class="contains-task-list">
<li class="task-list-item"><input type="checkbox" disabled> Task 1</li>
<li class="task-list-item"><input type="checkbox" disabled> Task 2</li>
<li class="task-list-item"><input type="checkbox" checked disabled> Task 3</li>
<li class="task-list-item"><input type="checkbox" disabled> Task 4</li>
<li class="task-list-item"><input type="checkbox" checked disabled> Task 5</li>
</ul>
<h3 id="plain-lists-with-attr_html">Plain lists with ATTR_HTML</h3>
<h4 id="unordered-lists">Unordered lists</h4>
<ul>
<li>Red list item 1</li>
<li>Red list item 2</li>
</ul>
<ul>
<li>Green list item 1</li>
<li>Green list item 2</li>
</ul>
