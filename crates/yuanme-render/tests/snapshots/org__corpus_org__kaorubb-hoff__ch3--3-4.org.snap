><mi>e</mi><mi>t</mi><mi>a</mi><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mn>23</mn><mo>,</mo><mn>30</mn><mo stretchy="false">)</mo></mtd><mtd style="width: 50%"></mtd></mtr></mtable></math>
