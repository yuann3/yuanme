></tr><tr><td><code>colon</code></td><td>:</td></tr><tr><td><code>div</code></td><td>÷</td></tr><tr><td><code>frac12</code></td><td>½</td></tr><tr><td><code>frac14</code></td><td>¼</td></tr><tr><td><code>frac34</code></td><td>¾</td></tr><tr><td><code>permil</code></td><td>‰</td></tr><tr><td><code>sup1</code></td><td>¹</td></tr><tr><td><code>sup2</code></td><td>²</td></tr><tr><td><code>sup3</code></td><td>³</td></tr><tr><td><code>radic</code></td><td>√</td></tr><tr><td><code>sum</code></td><td>∑</td></tr><tr><td><code>prod</code></td><td>∏</td></tr><tr><td><code>micro</code></td><td>µ</td></tr><tr><td><code>macr</code></td><td>¯</td></tr><tr><td><code>deg</code></td><td>°</td></tr><tr><td><code>prime</code></td><td>′</td></tr><tr><td><code>Prime</code></td><td>″</td></tr><tr><td><code>infin</code></td><td>∞</td></tr><tr><td><code>infty</code></td><td>∞</td></tr><tr><td><code>prop</code></td><td>∝</td></tr><tr><td><code>propto</code></td><td>∝</td></tr><tr><td><code>not</code></td><td>¬</td></tr><tr><td><code>neg</code></td><td>¬</td></tr><tr><td><code>land</code></td><td>∧</td></tr><tr><td><code>wedge</code></td><td>∧</td></tr><tr><td><code>lor</code></td><td>∨</td></tr><tr><td><code>vee</code></td><td>∨</td></tr><tr><td><code>cap</code></td><td>∩</td></tr><tr><td><code>cup</code></td><td>∪</td></tr><tr><td><code>smile</code></td><td>⌣</td></tr><tr><td><code>frown</code></td><td>⌢</td></tr><tr><td><code>int</code></td><td>∫</td></tr><tr><td><code>therefore</code></td><td>∴</td></tr><tr><td><code>there4</code></td><td>∴</td></tr><tr><td><code>because</code></td><td>∵</td></tr><tr><td><code>sim</code></td><td>∼</td></tr><tr><td><code>cong</code></td><td>≅</td></tr><tr><td><code>simeq</code></td><td>≅</td></tr><tr><td><code>asymp</code></td><td>≈</td></tr><tr><td><code>approx</code></td><td>≈</td></tr><tr><td><code>ne</code></td><td>≠</td></tr><tr><td><code>neq</code></td><td>≠</td></tr><tr><td><code>equiv</code></td><td>≡</td></tr><tr><td><code>triangleq</code></td><td>≜</td></tr><tr><td><code>le</code></td><td>≤</td></tr><tr><td><code>leq</code></td><td>≤</td></tr><tr><td><code>ge</code></td><td>≥</td></tr><tr><td><code>geq</code></td><td>≥</td></tr><tr><td><code>lessgtr</code></td><td>≶</td></tr><tr><td><code>lesseqgtr</code></td><td>⋚</td></tr><tr><td><code>ll</code></td><td>≪</td></tr><tr><td><code>Ll</code></td><td>⋘</td></tr><tr><td><code>lll</code></td><td>⋘</td></tr><tr><td><code>gg</code></td><td>≫</td></tr><tr><td><code>Gg</code></td><td>⋙</td></tr><tr><td><code>ggg</code></td><td>⋙</td></tr><tr><td><code>prec</code></td><td>≺</td></tr><tr><td><code>preceq</code></td><td>≼</td></tr><tr><td><code>preccurlyeq</code></td><td>≼</td></tr><tr><td><code>succ</code></td><td>≻</td></tr><tr><td><code>succeq</code></td><td>≽</td></tr><tr><td><code>succcurlyeq</code></td><td>≽</td></tr><tr><td><code>sub</code></td><td>⊂</td></tr><tr><td><code>subset</code></td><td>⊂</td></tr><tr><td><code>sup</code></td><td>⊃</td></tr><tr><td><code>supset</code></td><td>⊃</td></tr><tr><td><code>nsub</code></td><td>⊄</td></tr><tr><td><code>sube</code></td><td>⊆</td></tr><tr><td><code>nsup</code></td><td>⊅</td></tr><tr><td><code>supe</code></td><td>⊇</td></tr><tr><td><code>setminus</code></td><td>⧵</td></tr><tr><td><code>forall</code></td><td>∀</td></tr><tr><td><code>exist</code></td><td>∃</td></tr><tr><td><code>exists</code></td><td>∃</td></tr><tr><td><code>nexist</code></td><td>∄</td></tr><tr><td><code>nexists</code></td><td>∄</td></tr><tr><td><code>empty</code></td><td>∅</td></tr><tr><td><code>emptyset</code></td><td>∅</td></tr><tr><td><code>isin</code></td><td>∈</td></tr><tr><td><code>in</code></td><td>∈</td></tr><tr><td><code>notin</code></td><td>∉</td></tr><tr><td><code>ni</code></td><td>∋</td></tr><tr><td><code>nabla</code></td><td>∇</td></tr><tr><td><code>ang</code></td><td>∠</td></tr><tr><td><code>angle</code></td><td>∠</td></tr><tr><td><code>perp</code></td><td>⊥</td></tr><tr><td><code>parallel</code></td><td>∥</td></tr><tr><td><code>sdot</