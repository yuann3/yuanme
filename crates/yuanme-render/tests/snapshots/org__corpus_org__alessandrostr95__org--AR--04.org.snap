space="0.2222em" rspace="0.2222em">⋅</mo><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mfrac><mn>8</mn><mn>5</mn></mfrac><mi>c</mi><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac></mrow></msup></mtd><mtd style="width: 50%"></mtd></mtr><mtr><mtd style="width: 50%"></mtd><mtd style="text-align: right;justify-items: end;padding-right: 0;"></mtd><mtd style="text-align: left;justify-items: start;padding-left: 0;"><mo>=</mo><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mn>2</mn><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac><mspace width="0.1667em"/><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0.2222em" rspace="0.2222em">⋅</mo><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mn>2</mn><mi>c</mi><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac></mrow></msup><mo>+</mo><mn>3</mn><mfrac><mrow><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi></mrow><msup><mi>n</mi><mfrac><mn>3</mn><mn>5</mn></mfrac></msup></mfrac><mo lspace="0.2222em" rspace="0.2222em">⋅</mo><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mfrac><mn>2</mn><mn>5</mn></mfrac><mspace width="0.1667em"/><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0.2222em" rspace="0.2222em">⋅</mo><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mfrac><mn>8</mn><mn>5</mn></mfrac><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac><mspace width="0.1667em"/><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0.2222em" rspace="0.2222em">⋅</mo><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mfrac><mn>8</mn><mn>5</mn></mfrac><mi>c</mi><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac></mrow></msup></mtd><mtd style="width: 50%"></mtd></mtr><mtr><mtd style="width: 50%"></mtd><mtd style="text-align: right;justify-items: end;padding-right: 0;"><mtext><b>(3)</b></mtext></mtd><mtd style="text-align: left;justify-items: start;padding-left: 0;"><mo>&lt;</mo><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mn>2</mn><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac><mspace width="0.1667em"/><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0.2222em" rspace="0.2222em">⋅</mo><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mn>2</mn><mi>c</mi><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac></mrow></msup><mo>+</mo><mn>3</mn><mfrac><mrow><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi></mrow><msup><mi>n</mi><mfrac><mn>3</mn><mn>5</mn></mfrac></msup></mfrac><mo lspace="0.2222em" rspace="0.2222em">⋅</mo><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mfrac><mn>2</mn><mn>5</mn></mfrac><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac><mspace width="0.1667em"/><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0.2222em" rspace="0.2222em">⋅</mo><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mfrac><mn>8</mn><mn>5</mn></mfrac><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac><mspace width="0.1667em"/><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0.2222em" rspace="0.2222em">⋅</mo><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mfrac><mn>8</mn><mn>5</mn></mfrac><mi>c</mi><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac></mrow></msup></mtd><mtd style="width: 50%"></mtd></mtr><mtr><mtd style="width: 50%"></mtd><mtd style="text-align: right;justify-items: end;padding-right: 0;"></mtd><mtd style="text-align: left;justify-items: start;padding-left: 0;"><mo>=</mo><msup><mi>n</mi><mrow><mo lspace="0" rspace="0">−</mo><mn>2</mn><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac></mrow></msup><mo lspace="0.2222em" rspace="0.2222em">⋅</mo><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mn>2</mn><mi>c</mi><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac></mrow></msup><mo>+</mo><mn>3</mn><mfrac><mrow><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi></mrow><msup><mi>n</mi><mfrac><mn>3</mn><mn>5</mn></mfrac></msup></mfrac><mo lspace="0.2222em" rspace="0.2222em">⋅</mo><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mfrac><mn>10</mn><mn>5</mn></mfrac><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac><mspace width="0.1667em"/><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0.2222em" rspace="0.2222em">⋅</mo><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mfrac><mn>8</mn><mn>5</mn></mfrac><mi>c</mi><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac></mrow></msup></mtd><mtd style="width: 50%"></mtd></mtr><mtr><mtd style="width: 50%"></mtd><mtd style="text-align: right;justify-items: end;padding-right: 0;"></mtd><mtd style="text-align: left;justify-items: start;padding-left: 0;"><mo>=</mo><msup><mi>n</mi><mrow><mo lspace="0" rspace="0">−</mo><mn>2</mn><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac></mrow></msup><mo lspace="0.2222em" rspace="0.2222em">⋅</mo><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mn>2</mn><mi>c</mi><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac></mrow></msup><mo>+</mo><mn>3</mn><mfrac><mrow><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi></mrow><msup><mi>n</mi><mfrac><mn>3</mn><mn>5</mn></mfrac></msup></mfrac><mo lspace="0.2222em" rspace="0.2222em">⋅</mo><msup><mi>n</mi><mrow><mo lspace="0" rspace="0">−</mo><mn>2</mn><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac></mrow></msup><mo lspace="0.2222em" rspace="0.2222em">⋅</mo><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mfrac><mn>8</mn><mn>5</mn></mfrac><mi>c</mi><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac></mrow></msup></mtd><mtd style="width: 50%"></mtd></mtr><mtr><mtd style="width: 50%"></mtd><mtd style="text-align: right;justify-items: end;padding-right: 0;"></mtd><mtd style="text-align: left;justify-items: start;padding-left: 0;"><mo>=</mo><msup><mi>n</mi><mrow><mo lspace="0" rspace="0">−</mo><mn>2</mn><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac></mrow></msup><mo lspace="0.2222em" rspace="0.2222em">⋅</mo><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mn>2</mn><mi>c</mi><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac></mrow></msup><mo lspace="0.2222em" rspace="0.2222em">⋅</mo><mrow><mo>[</mo><mn>1</mn><mo>+</mo><mn>3</mn><mfrac><mrow><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi></mrow><msup><mi>n</mi><mfrac><mn>3</mn><mn>5</mn></mfrac></msup></mfrac><mo lspace="0.2222em" rspace="0.2222em">⋅</mo><msup><mi>e</mi><mrow><mfrac><mn>2</mn><mn>5</mn></mfrac><mi>c</mi><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac></mrow></msup><mo>]</mo></mrow></mtd><mtd style="width: 50%"></mtd></mtr></mtable></math>
<p>dove:</p>
<ul>
<li><strong>(1)</strong> perché <math><mn>1</mn><mo>−</mo><mi>x</mi><mo>&lt;</mo><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mi>x</mi></mrow></msup></math> per ogni <math><mi>x</mi><mo>≠</mo><mn>0</mn></math>.</li>
<li><strong>(2)</strong> perché <math><mfrac><mn>1</mn><mi>n</mi></mfrac><mo>=</mo><mfrac><mn>1</mn><msup><mi>n</mi><mrow><mn>3</mn><mo lspace="0" rspace="0">/</mo><mn>5</mn><mo lspace="0" rspace="0">+</mo><mn>2</mn><mo lspace="0" rspace="0">/</mo><mn>5</mn></mrow></msup></mfrac><mo>=</mo><mfrac><mn>1</mn><mrow><msup><mi>n</mi><mrow><mn>3</mn><mo lspace="0" rspace="0">/</mo><mn>5</mn></mrow></msup><mo lspace="0" rspace="0">⋅</mo><msup><mi>n</mi><mrow><mn>2</mn><mo lspace="0" rspace="0">/</mo><mn>5</mn></mrow></msup></mrow></mfrac><mo>=</mo><mfrac><mn>1</mn><msup><mi>n</mi><mrow><mn>3</mn><mo lspace="0" rspace="0">/</mo><mn>5</mn></mrow></msup></mfrac><mo lspace="0.2222em" rspace="0.2222em">⋅</mo><msup><mi>n</mi><mrow><mo lspace="0" rspace="0">−</mo><mn>2</mn><mo lspace="0" rspace="0">/</mo><mn>5</mn></mrow></msup></math>.</li>
<li><strong>(3)</strong> perché viene moltiplicato <math><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mfrac><mn>2</mn><mn>5</mn></mfrac><mspace width="0.1667em"/><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></math> per <math><msup><mi>e</mi><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac></msup></math>.</li>
</ul>
<hr>
<p>Riassumendo abbiamo visto che</p>

<p>con</p>
<ul>
<li><math><mrow><mspace/><mi>𝒫︀</mi></mrow><mo stretchy="false">(</mo><msub><mrow><mspace/><mi>ℰ︀</mi></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo>≥</mo><msup><mrow><mo>(</mo><mn>1</mn><mo>−</mo><mi>π</mi><msup><mi>r</mi><mn>2</mn></msup><mo>)</mo></mrow><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>1</mn></mrow></msup></math></li>
<li><math><mrow><mspace/><mi>𝒫︀</mi></mrow><mo stretchy="false">(</mo><msub><mrow><mspace/><mi>ℰ︀</mi></mrow><mrow><mi>i</mi><mi>j</mi></mrow></msub><mo stretchy="false">)</mo><mo>&lt;</mo><msup><mi>n</mi><mrow><mo lspace="0" rspace="0">−</mo><mn>2</mn><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac></mrow></msup><mo lspace="0.2222em" rspace="0.2222em">⋅</mo><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mn>2</mn><mi>c</mi><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac></mrow></msup><mo lspace="0.2222em" rspace="0.2222em">⋅</mo><mrow><mo>[</mo><mn>1</mn><mo>+</mo><mn>3</mn><mfrac><mrow><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0" rspace="0">+</mo><mi>c</mi></mrow><msup><mi>n</mi><mfrac><mn>3</mn><mn>5</mn></mfrac></msup></mfrac><mo lspace="0.2222em" rspace="0.2222em">⋅</mo><msup><mi>e</mi><mrow><mfrac><mn>2</mn><mn>5</mn></mfrac><mi>c</mi><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac></mrow></msup><mo>]</mo></mrow></math></li>
</ul>
<p>perciò avremo che il limite inferiore alla probabilità che <math><mi>G</mi></math> sia <strong>non connesso</strong> è
</p>
<p>A questo punto è utile vedere che per <math><mi>n</mi><mo stretchy="false">→</mo><mi>∞</mi></math>
<math display="block"><mrow><munder><mrow><mspace/><mi>lim</mi></mrow><mrow><mi>n</mi><mo stretchy="false" lspace="0" rspace="0">→</mo><mi>∞</mi></mrow></munder><mo lspace="0.1667em">&ApplyFunction;</mo><mi>n</mi></mrow><mo stretchy="false">(</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo><msup><mi>n</mi><mrow><mo lspace="0" rspace="0">−</mo><mn>2</mn><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac></mrow></msup><mo lspace="0.2222em" rspace="0.2222em">⋅</mo><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mn>2</mn><mi>c</mi><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac></mrow></msup><mo lspace="0.2222em" rspace="0.2222em">⋅</mo><mrow><mo>[</mo><mn>1</mn><mo>+</mo><mn>3</mn><mfrac><mrow><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi></mrow><msup><mi>n</mi><mfrac><mn>3</mn><mn>5</mn></mfrac></msup></mfrac><mo lspace="0.2222em" rspace="0.2222em">⋅</mo><msup><mi>e</mi><mrow><mfrac><mn>2</mn><mn>5</mn></mfrac><mi>c</mi><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac></mrow></msup><mo>]</mo></mrow><mo>=</mo><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mn>2</mn><mi>c</mi></mrow></msup></math>
perché</p>
<ul>
<li><math><mrow><msub><mrow><mspace/><mi>lim</mi></mrow><mrow><mi>n</mi><mo stretchy="false" lspace="0" rspace="0">→</mo><mi>∞</mi></mrow></msub><mo lspace="0.1667em">&ApplyFunction;</mo><mi>n</mi></mrow><mo stretchy="false">(</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo><msup><mi>n</mi><mrow><mo lspace="0" rspace="0">−</mo><mn>2</mn><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac></mrow></msup><mo>=</mo><mn>1</mn></math></li>
<li><math><mrow><msub><mrow><mspace/><mi>lim</mi></mrow><mrow><mi>n</mi><mo stretchy="false" lspace="0" rspace="0">→</mo><mi>∞</mi></mrow></msub><mo lspace="0.1667em">&ApplyFunction;</mo><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mn>2</mn><mi>c</mi><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac></mrow></msup></mrow><mo>=</mo><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mn>2</mn><mi>c</mi></mrow></msup></math></li>
<li><math><mrow><msub><mrow><mspace/><mi>lim</mi></mrow><mrow><mi>n</mi><mo stretchy="false" lspace="0" rspace="0">→</mo><mi>∞</mi></mrow></msub><mo lspace="0.1667em">&ApplyFunction;</mo><mn>3</mn></mrow><mfrac><mrow><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0" rspace="0">+</mo><mi>c</mi></mrow><msup><mi>n</mi><mfrac><mn>3</mn><mn>5</mn></mfrac></msup></mfrac><mo lspace="0.2222em" rspace="0.2222em">⋅</mo><msup><mi>e</mi><mrow><mfrac><mn>2</mn><mn>5</mn></mfrac><mi>c</mi><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac></mrow></msup><mo>=</mo><mn>0</mn></math></li>
</ul>
<p>Dato che questo limite approccia <math><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mn>2</mn><mi>c</mi></mrow></msup></math> dall’<em>alto</em>, vul dire che per ogni <math><mi>ε</mi><mo>&gt;</mo><mn>0</mn></math> esisterà un <math><msub><mi>n</mi><mi>ε</mi></msub><mo>&gt;</mo><mn>0</mn></math> tale che per
<math><mi>n</mi><mo>≥</mo><msub><mi>n</mi><mi>ε</mi></msub></math> è vero che
<math display="block"><mi>n</mi><mo stretchy="false">(</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo><msup><mi>n</mi><mrow><mo lspace="0" rspace="0">−</mo><mn>2</mn><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac></mrow></msup><mo lspace="0.2222em" rspace="0.2222em">⋅</mo><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mn>2</mn><mi>c</mi><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac></mrow></msup><mo lspace="0.2222em" rspace="0.2222em">⋅</mo><mrow><mo>[</mo><mn>1</mn><mo>+</mo><mn>3</mn><mfrac><mrow><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi></mrow><msup><mi>n</mi><mfrac><mn>3</mn><mn>5</mn></mfrac></msup></mfrac><mo lspace="0.2222em" rspace="0.2222em">⋅</mo><msup><mi>e</mi><mrow><mfrac><mn>2</mn><mn>5</mn></mfrac><mi>c</mi><mfrac><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>2</mn></mrow><mi>n</mi></mfrac></mrow></msup><mo>]</mo></mrow><mo>&lt;</mo><mo stretchy="false">(</mo><mn>1</mn><mo>+</mo><mi>ε</mi><mo stretchy="false">)</mo><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mn>2</mn><mi>c</mi></mrow></msup></math></p>
<p>Perciò
</p>
<p>Per dimostrare che  basta dimostrare che da un certo <math><mi>n</mi></math> in poi <math><mi>n</mi><msup><mrow><mo lspace="0.1667em">(</mo><mn>1</mn><mo>−</mo><mi>π</mi><msup><mi>r</mi><mn>2</mn></msup><mo>)</mo></mrow><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>1</mn></mrow></msup><mo>−</mo><mo stretchy="false">(</mo><mn>1</mn><mo>+</mo><mi>ε</mi><mo stretchy="false">)</mo><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mn>2</mn><mi>c</mi></mrow></msup><mo>&gt;</mo><mn>0</mn></math>.
La precedente affermazione equivale a dimostrare che da un certo <math><mi>n</mi></math> in poi <math><mi>n</mi><msup><mrow><mo lspace="0.1667em">(</mo><mn>1</mn><mo>−</mo><mi>π</mi><msup><mi>r</mi><mn>2</mn></msup><mo>)</mo></mrow><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>1</mn></mrow></msup><mo>&gt;</mo><mo stretchy="false">(</mo><mn>1</mn><mo>+</mo><mi>ε</mi><mo stretchy="false">)</mo><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mn>2</mn><mi>c</mi></mrow></msup></math>.
Iniziamo col calcolare il <em>logaritmo naturale</em> di entrambi i membri.
Partendo dal primo (a sinistra)</p>
<math display="block"><mtable displaystyle="true" scriptlevel="0" style="width: 100%"><mtr><mtd style="width: 50%"></mtd><mtd style="text-align: right;justify-items: end;padding-right: 0;"><mo lspace="0" rspace="0">ln</mo><mrow><mo>(</mo><mi>n</mi><msup><mrow><mo lspace="0.1667em">(</mo><mn>1</mn><mo>−</mo><mi>π</mi><msup><mi>r</mi><mn>2</mn></msup><mo>)</mo></mrow><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>1</mn></mrow></msup><mo>)</mo></mrow></mtd><mtd style="text-align: left;justify-items: start;padding-left: 0;"><mo>=</mo><mo lspace="0" rspace="0">ln</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><mo lspace="0" rspace="0">ln</mo><mrow><mo>(</mo><msup><mrow><mo>(</mo><mn>1</mn><mo>−</mo><mi>π</mi><msup><mi>r</mi><mn>2</mn></msup><mo>)</mo></mrow><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>1</mn></mrow></msup><mo>)</mo></mrow></mtd><mtd style="width: 50%"></mtd></mtr><mtr><mtd style="width: 50%"></mtd><mtd style="text-align: right;justify-items: end;padding-right: 0;"></mtd><mtd style="text-align: left;justify-items: start;padding-left: 0;"><mo>=</mo><mo lspace="0" rspace="0">ln</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><mo stretchy="false">(</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo><mo lspace="0.1667em" rspace="0">ln</mo><mrow><mo>(</mo><mrow><mo>(</mo><mn>1</mn><mo>−</mo><mi>π</mi><msup><mi>r</mi><mn>2</mn></msup><mo>)</mo></mrow><mo>)</mo></mrow></mtd><mtd style="width: 50%"></mtd></mtr><mtr><mtd style="width: 50%"></mtd><mtd style="text-align: right;justify-items: end;padding-right: 0;"><mtext><b>(1)</b></mtext></mtd><mtd style="text-align: left;justify-items: start;padding-left: 0;"><mo>=</mo><mo lspace="0" rspace="0">ln</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mo stretchy="false">(</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo><munderover><mo>∑</mo><mrow><mi>k</mi><mo lspace="0" rspace="0">=</mo><mn>1</mn></mrow><mi>∞</mi></munderover><mfrac><msup><mrow><mo>(</mo><mi>π</mi><msup><mi>r</mi><mn>2</mn></msup><mo>)</mo></mrow><mi>k</mi></msup><mi>k</mi></mfrac></mtd><mtd style="width: 50%"></mtd></mtr></mtable></math>
<p>dove <strong>(1)</strong> perché per <math><mi>x</mi><mo>&lt;</mo><mn>1</mn></math> vale che <math><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mo lspace="0" rspace="0">−</mo><munderover><mo>∑</mo><mrow><mi>k</mi><mo lspace="0" rspace="0">=</mo><mn>1</mn></mrow><mi>∞</mi></munderover><mfrac><msup><mi>x</mi><mi>k</mi></msup><mi>k</mi></mfrac></math><br>
</p>
<p>Poniamo dunque <math><mi>r</mi><mo>=</mo><msqrt><mfrac><mrow><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0" rspace="0">+</mo><mi>c</mi></mrow><mrow><mi>n</mi><mi>π</mi></mrow></mfrac></msqrt></math> e <math><mi>δ</mi><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></math> la serie precedente che parte da 3 e va <math><mi>∞</mi></math>.
Otterremo che</p>
<math display="block"><mtable displaystyle="true" scriptlevel="0" style="width: 100%"><mtr><mtd style="width: 50%"></mtd><mtd style="text-align: right;justify-items: end;padding-right: 0;"><mo lspace="0" rspace="0">ln</mo><mrow><mo>(</mo><mi>n</mi><msup><mrow><mo lspace="0.1667em">(</mo><mn>1</mn><mo>−</mo><mi>π</mi><msup><mi>r</mi><mn>2</mn></msup><mo>)</mo></mrow><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>1</mn></mrow></msup><mo>)</mo></mrow></mtd><mtd style="text-align: left;justify-items: start;padding-left: 0;"><mo>=</mo><mo lspace="0" rspace="0">ln</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mo stretchy="false">(</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo><munderover><mo>∑</mo><mrow><mi>k</mi><mo lspace="0" rspace="0">=</mo><mn>1</mn></mrow><mi>∞</mi></munderover><mfrac><msup><mrow><mo>(</mo><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi><mo>)</mo></mrow><mi>k</mi></msup><mrow><mi>k</mi><msup><mi>n</mi><mi>k</mi></msup></mrow></mfrac></mtd><mtd style="width: 50%"></mtd></mtr><mtr><mtd style="width: 50%"></mtd><mtd style="text-align: right;justify-items: end;padding-right: 0;"></mtd><mtd style="text-align: left;justify-items: start;padding-left: 0;"><mo>=</mo><mo lspace="0" rspace="0">ln</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mo stretchy="false">(</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo><munderover><mo>∑</mo><mrow><mi>k</mi><mo lspace="0" rspace="0">=</mo><mn>1</mn></mrow><mn>2</mn></munderover><mfrac><msup><mrow><mo>(</mo><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi><mo>)</mo></mrow><mi>k</mi></msup><mrow><mi>k</mi><msup><mi>n</mi><mi>k</mi></msup></mrow></mfrac><mo>+</mo><mi>δ</mi><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mtd><mtd style="width: 50%"></mtd></mtr><mtr><mtd style="width: 50%"></mtd><mtd style="text-align: right;justify-items: end;padding-right: 0;"></mtd><mtd style="text-align: left;justify-items: start;padding-left: 0;"><mo>=</mo><mo lspace="0" rspace="0">ln</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mo stretchy="false">(</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo><mrow><mo lspace="0.1667em">[</mo><mfrac><mrow><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi></mrow><mi>n</mi></mfrac><mo>+</mo><mfrac><msup><mrow><mo>(</mo><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi><mo>)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><msup><mi>n</mi><mn>2</mn></msup></mrow></mfrac><mo>+</mo><mi>δ</mi><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo><mo>]</mo></mrow></mtd><mtd style="width: 50%"></mtd></mtr></mtable></math>
<p>Non resta che stimare <math><mi>δ</mi><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></math>.</p>
<math display="block"><mtable displaystyle="true" scriptlevel="0" style="width: 100%"><mtr><mtd style="width: 50%"></mtd><mtd style="text-align: right;justify-items: end;padding-right: 0;"><mi>δ</mi><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mtd><mtd style="text-align: left;justify-items: start;padding-left: 0;"><mo>=</mo><munderover><mo lspace="0">∑</mo><mrow><mi>k</mi><mo lspace="0" rspace="0">=</mo><mn>3</mn></mrow><mi>∞</mi></munderover><mfrac><msup><mrow><mo>(</mo><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi><mo>)</mo></mrow><mi>k</mi></msup><mrow><mi>k</mi><msup><mi>n</mi><mi>k</mi></msup></mrow></mfrac></mtd><mtd style="width: 50%"></mtd></mtr><mtr><mtd style="width: 50%"></mtd><mtd style="text-align: right;justify-items: end;padding-right: 0;"></mtd><mtd style="text-align: left;justify-items: start;padding-left: 0;"><mo>≤</mo><munderover><mo lspace="0">∑</mo><mrow><mi>k</mi><mo lspace="0" rspace="0">=</mo><mn>3</mn></mrow><mi>∞</mi></munderover><mfrac><msup><mrow><mo>(</mo><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi><mo>)</mo></mrow><mi>k</mi></msup><mrow><mn>3</mn><msup><mi>n</mi><mi>k</mi></msup></mrow></mfrac><mo>=</mo><mfrac><mn>1</mn><mn>3</mn></mfrac><munderover><mo>∑</mo><mrow><mi>k</mi><mo lspace="0" rspace="0">=</mo><mn>3</mn></mrow><mi>∞</mi></munderover><msup><mrow><mo>(</mo><mfrac><mrow><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi></mrow><mi>n</mi></mfrac><mo>)</mo></mrow><mi>k</mi></msup></mtd><mtd style="width: 50%"></mtd></mtr><mtr><mtd style="width: 50%"></mtd><mtd style="text-align: right;justify-items: end;padding-right: 0;"></mtd><mtd style="text-align: left;justify-items: start;padding-left: 0;"><mo>≤</mo><mfrac><mn>1</mn><mn>3</mn></mfrac><msubsup><mo>∫</mo><mn>2</mn><mi>∞</mi></msubsup><mpadded style="padding-right:0.1667em;"><msup><mrow><mo>(</mo><mfrac><mrow><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi></mrow><mi>n</mi></mfrac><mo>)</mo></mrow><mi>x</mi></msup></mpadded><mspace width="0.16666667em"/><mi>d</mi><mi>x</mi></mtd><mtd style="width: 50%"></mtd></mtr><mtr><mtd style="width: 50%"></mtd><mtd style="text-align: right;justify-items: end;padding-right: 0;"></mtd><mtd style="text-align: left;justify-items: start;padding-left: 0;"><mo>=</mo><munder><mo lspace="0" rspace="0.1667em">lim</mo><mrow><mi>h</mi><mo stretchy="false" lspace="0" rspace="0">→</mo><mi>∞</mi></mrow></munder><mfrac><mn>1</mn><mn>3</mn></mfrac><msubsup><mo>∫</mo><mn>2</mn><mi>h</mi></msubsup><mpadded style="padding-right:0.1667em;"><msup><mrow><mo>(</mo><mfrac><mrow><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi></mrow><mi>n</mi></mfrac><mo>)</mo></mrow><mi>x</mi></msup></mpadded><mspace width="0.16666667em"/><mi>d</mi><mi>x</mi></mtd><mtd style="width: 50%"></mtd></mtr><mtr><mtd style="width: 50%"></mtd><mtd style="text-align: right;justify-items: end;padding-right: 0;"></mtd><mtd style="text-align: left;justify-items: start;padding-left: 0;"><mo>=</mo><munder><mo lspace="0" rspace="0.1667em">lim</mo><mrow><mi>h</mi><mo stretchy="false" lspace="0" rspace="0">→</mo><mi>∞</mi></mrow></munder><mfrac><mn>1</mn><mn>3</mn></mfrac><msubsup><mo>∫</mo><mn>2</mn><mi>h</mi></msubsup><msup><mi>e</mi><mrow><mi>x</mi><mrow><mo>(</mo><mfrac><mrow><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0" rspace="0">+</mo><mi>c</mi></mrow><mi>n</mi></mfrac><mo>)</mo></mrow></mrow></msup><mspace width="0.16666667em"/><mi>d</mi><mi>x</mi></mtd><mtd style="width: 50%"></mtd></mtr><mtr><mtd style="width: 50%"></mtd><mtd style="text-align: right;justify-items: end;padding-right: 0;"></mtd><mtd style="text-align: left;justify-items: start;padding-left: 0;"><mo>=</mo><munder><mo lspace="0" rspace="0.1667em">lim</mo><mrow><mi>h</mi><mo stretchy="false" lspace="0" rspace="0">→</mo><mi>∞</mi></mrow></munder><msubsup><mrow><mo>[</mo><mfrac><mn>1</mn><mn>3</mn></mfrac><mfrac><mn>1</mn><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo>(</mo><mfrac><mrow><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0" rspace="0">+</mo><mi>c</mi></mrow><mi>n</mi></mfrac><mo>)</mo></mrow></mrow></mfrac><msup><mi>e</mi><mrow><mi>x</mi><mrow><mo>(</mo><mfrac><mrow><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0" rspace="0">+</mo><mi>c</mi></mrow><mi>n</mi></mfrac><mo>)</mo></mrow></mrow></msup><mo>]</mo></mrow><mn>2</mn><mi>h</mi></msubsup></mtd><mtd style="width: 50%"></mtd></mtr><mtr><mtd style="width: 50%"></mtd><mtd style="text-align: right;justify-items: end;padding-right: 0;"></mtd><mtd style="text-align: left;justify-items: start;padding-left: 0;"><mo>=</mo><munder><mo lspace="0" rspace="0.1667em">lim</mo><mrow><mi>h</mi><mo stretchy="false" lspace="0" rspace="0">→</mo><mi>∞</mi></mrow></munder><msubsup><mrow><mo>[</mo><mfrac><mn>1</mn><mn>3</mn></mfrac><mfrac><mn>1</mn><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo>(</mo><mfrac><mrow><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0" rspace="0">+</mo><mi>c</mi></mrow><mi>n</mi></mfrac><mo>)</mo></mrow></mrow></mfrac><msup><mrow><mo lspace="0.1667em">(</mo><mfrac><mrow><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi></mrow><mi>n</mi></mfrac><mo>)</mo></mrow><mi>x</mi></msup><mo>]</mo></mrow><mn>2</mn><mi>h</mi></msubsup></mtd><mtd style="width: 50%"></mtd></mtr><mtr><mtd style="width: 50%"></mtd><mtd style="text-align: right;justify-items: end;padding-right: 0;"><mtext><b>(a)</b></mtext></mtd><mtd style="text-align: left;justify-items: start;padding-left: 0;"><mo>=</mo><mo lspace="0" rspace="0">−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac><mfrac><mn>1</mn><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo>(</mo><mfrac><mrow><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0" rspace="0">+</mo><mi>c</mi></mrow><mi>n</mi></mfrac><mo>)</mo></mrow></mrow></mfrac><msup><mrow><mo lspace="0.1667em">(</mo><mfrac><mrow><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi></mrow><mi>n</mi></mfrac><mo>)</mo></mrow><mn>2</mn></msup></mtd><mtd style="width: 50%"></mtd></mtr><mtr><mtd style="width: 50%"></mtd><mtd style="text-align: right;justify-items: end;padding-right: 0;"><mtext><b>(b)</b></mtext></mtd><mtd style="text-align: left;justify-items: start;padding-left: 0;"><mo>=</mo><mfrac><mn>1</mn><mn>3</mn></mfrac><mfrac><mn>1</mn><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo>(</mo><mfrac><mi>n</mi><mrow><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0" rspace="0">+</mo><mi>c</mi></mrow></mfrac><mo>)</mo></mrow></mrow></mfrac><msup><mrow><mo lspace="0.1667em">(</mo><mfrac><mrow><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi></mrow><mi>n</mi></mfrac><mo>)</mo></mrow><mn>2</mn></msup></mtd><mtd style="width: 50%"></mtd></mtr></mtable></math>
<p>dove <strong>(a)</strong> perché <math><mrow><msub><mrow><mspace/><mi>lim</mi></mrow><mrow><mi>h</mi><mo stretchy="false" lspace="0" rspace="0">→</mo><mi>∞</mi></mrow></msub><mo lspace="0.1667em">&ApplyFunction;</mo><msup><mrow><mo>(</mo><mfrac><mrow><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0" rspace="0">+</mo><mi>c</mi></mrow><mi>n</mi></mfrac><mo>)</mo></mrow><mi>h</mi></msup></mrow><mo>=</mo><mn>0</mn></math> perché <math><mfrac><mrow><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0" rspace="0">+</mo><mi>c</mi></mrow><mi>n</mi></mfrac><mo>&lt;</mo><mn>1</mn></math> per <math><mi>n</mi></math> abbastanza grande,
mentre <strong>(b)</strong> perché viene spostato il simbolo negativo su <math><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo>(</mo><mfrac><mrow><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0" rspace="0">+</mo><mi>c</mi></mrow><mi>n</mi></mfrac><mo>)</mo></mrow></mrow></math> trasformandolo in <math><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo>(</mo><mfrac><mi>n</mi><mrow><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0" rspace="0">+</mo><mi>c</mi></mrow></mfrac><mo>)</mo></mrow></mrow></math>.
Infine poiché <math><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo>(</mo><mfrac><mi>n</mi><mrow><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0" rspace="0">+</mo><mi>c</mi></mrow></mfrac><mo>)</mo></mrow></mrow><mo>&lt;</mo><mn>1</mn></math> per <math><mi>n</mi></math> sufficentemente grande, avremo che
<math display="block"><mi>δ</mi><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo><mo>&lt;</mo><mfrac><mn>1</mn><mn>3</mn></mfrac><mfrac><msup><mrow><mo>(</mo><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi><mo>)</mo></mrow><mn>2</mn></msup><msup><mi>n</mi><mn>2</mn></msup></mfrac></math></p>
<p>Unendo i pezzi abbiamo che per valori di <math><mi>n</mi></math> abbastanza grandi</p>
<math display="block"><mtable displaystyle="true" scriptlevel="0" style="width: 100%"><mtr><mtd style="width: 50%"></mtd><mtd style="text-align: right;justify-items: end;padding-right: 0;"><mo lspace="0" rspace="0">ln</mo><mrow><mo>(</mo><mi>n</mi><msup><mrow><mo lspace="0.1667em">(</mo><mn>1</mn><mo>−</mo><mi>π</mi><msup><mi>r</mi><mn>2</mn></msup><mo>)</mo></mrow><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>1</mn></mrow></msup><mo>)</mo></mrow></mtd><mtd style="text-align: left;justify-items: start;padding-left: 0;"><mo>=</mo><mo lspace="0" rspace="0">ln</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mo stretchy="false">(</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo><mrow><mo lspace="0.1667em">[</mo><mfrac><mrow><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi></mrow><mi>n</mi></mfrac><mo>+</mo><mfrac><msup><mrow><mo>(</mo><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi><mo>)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><msup><mi>n</mi><mn>2</mn></msup></mrow></mfrac><mo>+</mo><mi>δ</mi><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo><mo>]</mo></mrow></mtd><mtd style="width: 50%"></mtd></mtr><mtr><mtd style="width: 50%"></mtd><mtd style="text-align: right;justify-items: end;padding-right: 0;"></mtd><mtd style="text-align: left;justify-items: start;padding-left: 0;"><mo>&gt;</mo><mo lspace="0" rspace="0">ln</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mo stretchy="false">(</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo><mrow><mo lspace="0.1667em">[</mo><mfrac><mrow><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi></mrow><mi>n</mi></mfrac><mo>+</mo><mfrac><msup><mrow><mo>(</mo><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi><mo>)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><msup><mi>n</mi><mn>2</mn></msup></mrow></mfrac><mo>+</mo><mfrac><mn>1</mn><mn>3</mn></mfrac><mfrac><msup><mrow><mo>(</mo><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi><mo>)</mo></mrow><mn>2</mn></msup><msup><mi>n</mi><mn>2</mn></msup></mfrac><mo>]</mo></mrow></mtd><mtd style="width: 50%"></mtd></mtr><mtr><mtd style="width: 50%"></mtd><mtd style="text-align: right;justify-items: end;padding-right: 0;"></mtd><mtd style="text-align: left;justify-items: start;padding-left: 0;"><mo>=</mo><mo lspace="0" rspace="0">ln</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mo stretchy="false">(</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo><mrow><mo lspace="0.1667em">[</mo><mfrac><mrow><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi></mrow><mi>n</mi></mfrac><mo>+</mo><mfrac><mn>5</mn><mn>6</mn></mfrac><mfrac><msup><mrow><mo>(</mo><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi><mo>)</mo></mrow><mn>2</mn></msup><msup><mi>n</mi><mn>2</mn></msup></mfrac><mo>]</mo></mrow></mtd><mtd style="width: 50%"></mtd></mtr><mtr><mtd style="width: 50%"></mtd><mtd style="text-align: right;justify-items: end;padding-right: 0;"></mtd><mtd style="text-align: left;justify-items: start;padding-left: 0;"><mo>=</mo><mo lspace="0" rspace="0">ln</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mfrac><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mi>n</mi></mfrac><mrow><mo lspace="0.1667em">(</mo><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi><mo>)</mo></mrow><mo>−</mo><mfrac><mn>5</mn><mn>6</mn></mfrac><mfrac><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo><msup><mrow><mo lspace="0.1667em">(</mo><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi><mo>)</mo></mrow><mn>2</mn></msup></mrow><msup><mi>n</mi><mn>2</mn></msup></mfrac></mtd><mtd style="width: 50%"></mtd></mtr><mtr><mtd style="width: 50%"></mtd><mtd style="text-align: right;justify-items: end;padding-right: 0;"><mtext><b>(c)</b></mtext></mtd><mtd style="text-align: left;justify-items: start;padding-left: 0;"><mo>&gt;</mo><mo lspace="0" rspace="0">ln</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo>(</mo><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi><mo>)</mo></mrow><mo>−</mo><mfrac><mn>5</mn><mn>6</mn></mfrac><mfrac><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo><msup><mrow><mo lspace="0.1667em">(</mo><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi><mo>)</mo></mrow><mn>2</mn></msup></mrow><msup><mi>n</mi><mn>2</mn></msup></mfrac></mtd><mtd style="width: 50%"></mtd></mtr><mtr><mtd style="width: 50%"></mtd><mtd style="text-align: right;justify-items: end;padding-right: 0;"></mtd><mtd style="text-align: left;justify-items: start;padding-left: 0;"><mo>=</mo><mo lspace="0" rspace="0">−</mo><mi>c</mi><mo>−</mo><mfrac><mn>5</mn><mn>6</mn></mfrac><mfrac><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo><msup><mrow><mo lspace="0.1667em">(</mo><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi><mo>)</mo></mrow><mn>2</mn></msup></mrow><msup><mi>n</mi><mn>2</mn></msup></mfrac></mtd><mtd style="width: 50%"></mtd></mtr></mtable></math>
<p>dove <strong>(c)</strong> perché <math><mfrac><mrow><mo stretchy="false">(</mo><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mi>n</mi></mfrac><mo>&lt;</mo><mn>1</mn></math>.<br>
</p>
<p>Per <math><mi>n</mi><mo stretchy="false">→</mo><mi>∞</mi></math> si ha che <math><mfrac><mn>5</mn><mn>6</mn></mfrac><mfrac><mrow><mo stretchy="false">(</mo><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>1</mn><mo stretchy="false">)</mo><msup><mrow><mo>(</mo><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0" rspace="0">+</mo><mi>c</mi><mo>)</mo></mrow><mn>2</mn></msup></mrow><msup><mi>n</mi><mn>2</mn></msup></mfrac><mo>≈</mo><mn>0</mn></math>, allora per ogni <math><mi>ω</mi><mo>&gt;</mo><mn>0</mn></math> esiste sempre
un <math><msub><mi>n</mi><mi>ω</mi></msub><mo>≥</mo><msub><mi>n</mi><mi>ε</mi></msub></math>  tale che per <math><mi>n</mi><mo>≥</mo><msub><mi>n</mi><mi>ω</mi></msub></math> vale la seguente disuguaglianza
<math display="block"><mfrac><mn>5</mn><mn>6</mn></mfrac><mfrac><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo><msup><mrow><mo lspace="0.1667em">(</mo><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi><mo>)</mo></mrow><mn>2</mn></msup></mrow><msup><mi>n</mi><mn>2</mn></msup></mfrac><mo>&lt;</mo><mi>ω</mi></math>
e ciò implica che per <math><mi>n</mi></math> abbastanza grande <math><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo>(</mo><mi>n</mi><msup><mrow><mo lspace="0.1667em">(</mo><mn>1</mn><mo>−</mo><mi>π</mi><msup><mi>r</mi><mn>2</mn></msup><mo>)</mo></mrow><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>1</mn></mrow></msup><mo>)</mo></mrow></mrow><mo>&gt;</mo><mo lspace="0" rspace="0">−</mo><mi>c</mi><mo>−</mo><mi>ω</mi></math>,
e dunque (elevando a potenza) <math><mi>n</mi><msup><mrow><mo lspace="0.1667em">(</mo><mn>1</mn><mo>−</mo><mi>π</mi><msup><mi>r</mi><mn>2</mn></msup><mo>)</mo></mrow><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>1</mn></mrow></msup><mo>&gt;</mo><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mi>c</mi><mo lspace="0" rspace="0">−</mo><mi>ω</mi></mrow></msup></math>.<br>
</p>
<p>Ponendo <math><mi>ω</mi><mo>=</mo><mi>c</mi><mo>−</mo><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>+</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow></math> verrà verificata la disuguaglianza voluta
<math display="block"><mi>n</mi><msup><mrow><mo lspace="0.1667em">(</mo><mn>1</mn><mo>−</mo><mi>π</mi><msup><mi>r</mi><mn>2</mn></msup><mo>)</mo></mrow><mrow><mi>n</mi><mo lspace="0" rspace="0">−</mo><mn>1</mn></mrow></msup><mo>&gt;</mo><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mi>c</mi><mo lspace="0" rspace="0">−</mo><mi>c</mi><mo lspace="0" rspace="0">+</mo><mspace width="0.1667em"/><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo lspace="0" rspace="0">+</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo>=</mo><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mn>2</mn><mi>c</mi></mrow></msup><msup><mi>e</mi><mrow><mrow><mspace/><mi>ln</mi></mrow><mo>&ApplyFunction;</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo lspace="0" rspace="0">+</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo>=</mo><mo stretchy="false">(</mo><mn>1</mn><mo>+</mo><mi>ε</mi><mo stretchy="false">)</mo><msup><mi>e</mi><mrow><mo lspace="0" rspace="0">−</mo><mn>2</mn><mi>c</mi></mrow></msup></math></p>
<p>dimostrando così la tesi del teorema

<math><mi>□</mi></math>.</p>
<hr>
<section data-footnotes="" class="footnotes"><h2 class="sr-only" id="footnote-label">Footnotes</h2>
<ol>
<li id="user-content-fn-1">
<p>ovvero una <em>clique</em> di <math><mi>n</mi></math> nodi. <a href="#user-content-fnref-1" data-footnote-backref="" aria-label="Back to reference 1" class="data-footnote-backref">↩</a></p>
</li>
<li id="user-content-fn-2">
<p>perché <math><mi>G</mi><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>r</mi><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo></math> è un evento aleatorio, e quindi si possono solo fare previsioni probabilistiche. <a href="#user-content-fnref-2" data-footnote-backref="" aria-label="Back to reference 2" class="data-footnote-backref">↩</a></p>
</li>
<li id="user-content-fn-3">
<p>ovvero che per ogni coppia di nodi <math><mi>x</mi><mo>,</mo><mi>y</mi></math> esista un cammino diretto da <math><mi>x</mi></math> ad <math><mi>y</mi></math> e un cammino diretto da <math><mi>y</mi></math> ad <math><mi>x</mi></math>. <a href="#user-content-fnref-3" data-footnote-backref="" aria-label="Back to reference 3" class="data-footnote-backref">↩</a></p>
</li>
<li id="user-content-fn-4">
<p>con probabilità <span class="underline">almeno</span> <math><mn>1</mn><mo>−</mo><msup><mrow><mo>(</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><mo>)</mo></mrow><mrow><mrow><mspace/><mi mathvariant="normal">Ω</mi></mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup></math>. <a href="#user-content-fnref-4" data-footnote-backref="" aria-label="Back to reference 4" class="data-footnote-backref">↩</a></p>
</li>
<li id="user-content-fn-5">
<p>trovare un’ulteriore delimitazione inferiore. <a href="#user-content-fnref-5" data-footnote-backref="" aria-label="Back to reference 5" class="data-footnote-backref">↩</a></p>
</li>
<li id="user-content-fn-6">
<p><math><mover accent="true"><mi>A</mi><mo stretchy="true">̲</mo></mover><mo>∩</mo><mover accent="true"><mi>B</mi><mo stretchy="true">̲</mo></mover><mo>≡</mo><mover accent="true"><mrow><mi>A</mi><mo>∪</mo><mi>B</mi></mrow><mo stretchy="true">̲</mo></mover></math> <a href="#user-content-fnref-6" data-footnote-backref="" aria-label="Back to reference 6" class="data-footnote-backref">↩</a></p>
</li>
<li id="user-content-fn-7">
<p>ovvero <em>disgiunti</em>. <a href="#user-content-fnref-7" data-footnote-backref="" aria-label="Back to reference 7" class="data-footnote-backref">↩</a></p>
</li>
</ol>
</section>
