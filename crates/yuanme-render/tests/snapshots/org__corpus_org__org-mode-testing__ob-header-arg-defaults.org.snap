<pre id="showvar"><code class="language-emacs-lisp">(mapconcat (lambda (n)
             (let* ((n (string (+ 48 n)))
                    (p (intern (concat "t" n))))
               (if (boundp p) (eval p) (concat "--" n))))
           (number-sequence 1 end)
           "/")
</code></pre>
