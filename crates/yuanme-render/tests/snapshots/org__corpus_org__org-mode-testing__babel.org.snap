<h2 id="pascals-triangle--exports-both-test">Pascal’s Triangle – exports both test</h2>
<pre id="pascals-triangle"><code class="language-emacs-lisp">(defun pascals-triangle (n)
  (if (= n 0)
      (list (list 1))
    (let* ((prev-triangle (pascals-triangle (- n 1)))
           (prev-row (car (reverse prev-triangle))))
      (append prev-triangle
              (list (cl-map 'list #'+
                            (append prev-row '(0))
                            (append '(0) prev-row)))))))

(pascals-triangle n)
</code></pre>
