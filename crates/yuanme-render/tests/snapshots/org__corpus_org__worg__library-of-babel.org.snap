<h2 id="org-reference">Org reference</h2>
<h3 id="headline-references">Headline references</h3>
<pre id="headline"><code class="language-emacs-lisp">(save-excursion
  (when file (get-file-buffer file))
  (org-open-link-from-string (org-make-link-string headline))
