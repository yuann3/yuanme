<h3 id="convert-every-element-of-a-table-to-a-string">Convert every element of a table to a string</h3>














<table id="hetero-table"><tbody><tr><td>1</td><td>2</td><td>3</td></tr><tr><td>a</td><td>b</td><td>c</td></tr></tbody></table>
<pre id="all-to-string"><code class="language-emacs-lisp">(defun all-to-string (tbl)
  (if (listp tbl)
      (mapcar #'all-to-string tbl)
    (if (stringp tbl)
        tbl
      (format "%s" tbl))))
(all-to-string tbl)
</code></pre>
