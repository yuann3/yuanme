<li><math><mrow><mspace/><mi>Pr</mi></mrow><mo stretchy="false">(</mo><msub><mi>γ</mi><mn>2</mn></msub><mo>=</mo><mn>1</mn><mo stretchy="false" lspace="0" rspace="0">|</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo><mo>≈</mo><mn>0.057</mn></math></li>
<li><math><mrow><mspace/><mi>Pr</mi></mrow><mo stretchy="false">(</mo><msub><mi>γ</mi><mn>3</mn></msub><mo>=</mo><mn>1</mn><mo stretchy="false" lspace="0" rspace="0">|</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo><mo>≈</mo><mn>1.000</mn></math></li>
<li><math><mrow><mspace/><mi>Pr</mi></mrow><mo stretchy="false">(</mo><msub><mi>γ</mi><mn>4</mn></msub><mo>=</mo><mn>1</mn><mo stretchy="false" lspace="0" rspace="0">|</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo><mo>≈</mo><mn>0.986</mn></math></li>
<li><math><mrow><mspace/><mi>Pr</mi></mrow><mo stretchy="false">(</mo><msub><mi>γ</mi><mn>5</mn></msub><mo>=</mo><mn>1</mn><mo stretchy="false" lspace="0" rspace="0">|</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo><mo>≈</mo><mn>1.000</mn></math></li>
</ul>
