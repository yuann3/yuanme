p_density_bg = plot(chn_βγ[:, ["β$(j)*γ$(j)" for j in 1:5], :], seriestype=:density, left_margin=10mm)
savefig("./ch10/img/exercise10-5c_density.png")
"#+NAME:exercise10-5c_density\n[[file:./img/exercise10-5c_density.png]]"
</code></pre>
