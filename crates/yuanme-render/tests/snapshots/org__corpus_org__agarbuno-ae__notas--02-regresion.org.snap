<pre><code class="language-R">results_train &#x3C;- lm_fit |>
  predict(new_data = nfl_train) |>
  mutate(truth = nfl_train$weekly_attendance,
         model = "lm")
results_train |>
  rmse(truth = truth, estimate = .pred)
</code></pre>
